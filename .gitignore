# Build output — reproduce it, never publish it.
android/build/
*.apk
*.aab

# The release signing key. Android binds app updates to this file: publishing
# it would let anyone sign a build that a user's phone would accept as a
# legitimate update. Never commit it, never commit its password.
*.keystore
*.jks
*.local
*.local.txt

# Scratch and OS noise
*.bak
*~
.DS_Store

# generated at build time from mobile.html
android/assets/

# apksigner signature block, and the icon preview (generated by a tool)
*.idsig
android/icon-preview.png

# the keystore password, kept beside the key, never in the repo
.keystore-password
